# Copiar para /etc/emprestimofacil/backend.env, fora do Git, com permissões 0600.
PUBLIC_ORIGIN=https://emprestimo.seudominio.com.br
APPLICATIONS_DB=/var/lib/emprestimofacil/applications.sqlite
DATA_ENCRYPTION_KEY=
APPLICATIONS_ENABLED=false
DATA_RETENTION_DAYS=30
BACKUP_RETENTION_DAYS=7
OPEN_FINANCE_REQUIRED=false
# Legado: true exige e-mail + SMS. false exige só e-mail, sem confirmar celular.
PHONE_VERIFICATION_REQUIRED=true
MAX_PRIVATE_STORAGE_MB=1024
MIN_FREE_DISK_MB=256
PF_DAILY_LIMIT=3

# E-mail: twilio (legado) ou resend (domínio próprio verificado).
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

BELVO_ENVIRONMENT=sandbox
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=
BELVO_WEBHOOK_TOKEN=
COMPANY_NAME=Empréstimo Fácil
COMPANY_TERMS_URL=

CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=
CAKTO_WEBHOOK_SECRET=
CAKTO_PAYMENTS_ENABLED=false
CAKTO_LOAN_COLLECTION_APPROVED=false
PAYMENT_RETENTION_DAYS=365

# Compra independente do produto AFILIADOS QG BALTIGO (R$ 7,49).
# Não controla nem bloqueia o cadastro PF ou a análise de empréstimos.
CAKTO_SALES_ENABLED=false
CAKTO_SALES_OFFER_ID=3bd8an5
SALES_RETENTION_DAYS=30
BALTIGO_SUPPORT_WHATSAPP=
